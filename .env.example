# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ห้ามใส่ prefix NEXT_PUBLIC_ ให้กับค่าใดในไฟล์นี้เด็ดขาด
# ทุกค่าถูกอ่านจากฝั่ง server เท่านั้น เบราว์เซอร์จะไม่เห็นค่าเหล่านี้เลย

# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API Keys -> service_role (secret)
# key นี้ข้าม RLS ได้ทั้งหมด ห้ามหลุดไปฝั่ง client
SUPABASE_SERVICE_ROLE_KEY=

# ไม่บังคับ ถ้าไม่ใส่ ระบบจะข้าม rate limit ไปเฉยๆ
# สมัครฟรีที่ https://upstash.com -> Redis -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ไม่บังคับ ตั้งเองเป็นสตริงสุ่มยาวๆ ใช้ยืนยันว่า Vercel Cron เป็นคนเรียก
CRON_SECRET=
